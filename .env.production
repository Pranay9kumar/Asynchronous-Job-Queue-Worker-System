NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb://mongo:27017/job_queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_NAME=jobs
DLQ_QUEUE_NAME=dead-letter-queue
MAX_RETRY_ATTEMPTS=4
WORKER_CONCURRENCY=3
RATE_LIMIT_MAX_JOBS_PER_MINUTE=100
DLQ_ALERT_THRESHOLD=10
FAILURE_RATE_ALERT_THRESHOLD=0.5
API_DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:8080
JOB_PROCESSING_DELAY_MS=3000
LOG_LEVEL=info