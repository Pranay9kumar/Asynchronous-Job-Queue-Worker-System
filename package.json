{
  "name": "asynchronous-job-queue-system",
  "version": "1.0.0",
  "description": "Production-grade asynchronous job queue and worker foundation using Node.js, Express, Redis, BullMQ, and MongoDB.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node api.js",
    "dev": "nodemon api.js",
    "start:api": "node api.js",
    "start:worker": "node worker.js",
    "start:combined": "node server.js",
    "simulate:load": "node src/scripts/simulateLoad.js",
    "simulate:workers": "node src/scripts/simulateWorkers.js",
    "simulate:duplicates": "node src/scripts/simulateDuplicates.js",
    "simulate:rate-limit": "node src/scripts/simulateRateLimit.js"
  },
  "dependencies": {
    "bullmq": "^5.34.10",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "mongoose": "^8.10.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
